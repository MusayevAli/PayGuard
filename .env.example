# Copy to .env (git-ignored) and fill in. agents/llm.py loads it; nothing else reads the key.
ANTHROPIC_API_KEY=sk-ant-...
# Hard budget for the key across every run on this machine (USD). Calls stop at the cap.
PAYGUARD_MAX_USD=15
# Extraction model (documents) and text model (explanations, persona replies).
PAYGUARD_MODEL=claude-opus-5
PAYGUARD_MODEL_TEXT=claude-haiku-4-5
